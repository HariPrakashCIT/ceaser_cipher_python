def caesar_cipher(text, shift, mode="encrypt"):
    """Encrypt or decrypt text using the Caesar cipher."""
    if mode not in ("encrypt", "decrypt"):
        raise ValueError("mode must be 'encrypt' or 'decrypt'")

    if mode == "decrypt":
        shift = -shift

    result = []

    for char in text:
        if "A" <= char <= "Z":
            new_char = chr((ord(char) - ord("A") + shift) % 26 + ord("A"))
            result.append(new_char)
        elif "a" <= char <= "z":
            new_char = chr((ord(char) - ord("a") + shift) % 26 + ord("a"))
            result.append(new_char)
        else:
            result.append(char)

    return "".join(result)


def main():
    print("--- Caesar Cipher CLI Tool ---")

    while True:
        mode = input("Choose mode (encrypt / decrypt): ").strip().lower()
        if mode in ("encrypt", "decrypt"):
            break
        print("Invalid choice. Please type 'encrypt' or 'decrypt'.")

    message = input("Enter your message: ")

    while True:
        try:
            shift = int(input("Enter shift value (integer, e.g., 3): "))
            break
        except ValueError:
            print("Please enter a valid whole number.")

    processed_text = caesar_cipher(message, shift, mode)
    print(f"\nResulting {mode}ed text:")
    print(processed_text)


if __name__ == "__main__":
    main()
